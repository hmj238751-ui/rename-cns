{
  "manifest_version": 3,
  "name": "论文文献智能改名",
  "version": "1.0.12",
  "description": "根据可自定义模板自动重命名下载的论文文件。 Automatically rename downloaded papers with customizable templates.",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://api.crossref.org/*",
    "https://eutils.ncbi.nlm.nih.gov/*",
    "https://export.arxiv.org/*",
    "https://aclanthology.org/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "论文文献智能改名",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
